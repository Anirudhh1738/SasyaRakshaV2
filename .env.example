# SasyaRaksha Environment Configuration Example
# Copy to .env locally and set these in Render Environment Variables for production.
# NEVER commit your real .env file or secrets!

# Server Port (3000 for local development; Render automatically injects PORT in production)
PORT="3000"
NODE_ENV="development"

# Public app origin (e.g., https://sasyaraksha.onrender.com in production)
APP_URL="http://localhost:3000"

# ==============================================================================
# Supabase PostgreSQL Connection
# Recommended for Render Free (IPv4 compatible):
#   Supabase Dashboard -> Connect -> Session Pooler (port 5432 or 6543)
# Example:
#   postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ==============================================================================
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Set to "false" ONLY for local Postgres without SSL; Supabase requires SSL ("true" or omitted)
# DATABASE_SSL="true"

# ==============================================================================
# Supabase Storage (Private Bucket: agriguard-images)
# Find these in Supabase Dashboard -> Project Settings -> API
# NEVER expose SUPABASE_SERVICE_ROLE_KEY in Vite/frontend code!
# ==============================================================================
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="agriguard-images"

# ==============================================================================
# Security & Authentication
# ==============================================================================
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Optional first-run reviewer bootstrap credentials (leave commented unless bootstrapping)
# AGRIGUARD_EXPERT_EMAIL="expert@sasyaraksha.local"
# AGRIGUARD_EXPERT_PASSWORD="SET_STRONG_PASSWORD_LOCALLY"
# AGRIGUARD_ADMIN_EMAIL="admin@sasyaraksha.local"
# AGRIGUARD_ADMIN_PASSWORD="SET_STRONG_PASSWORD_LOCALLY"

# ==============================================================================
# Optional AI Services & SQLite Migration Source
# ==============================================================================
# Optional Python PyTorch + OpenCV inference server URL
PYTHON_AI_URL="http://127.0.0.1:8000"

# Optional Gemini API Key (injected automatically in AI Studio or set on Render)
GEMINI_API_KEY=""

# Optional path to legacy SQLite file ONLY when running scripts/migrate_sqlite_to_supabase.ts
# AGRIGUARD_DB_PATH="./agriguard.db"
